---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { siteInfo, type CatalogItem } from '../data/site-info';
import { ScoreTag } from '../lib/protected-pdf';
import 'pdfjs-dist/web/pdf_viewer.css';

export async function getStaticPaths() {
  const pages = await Promise.all(
    siteInfo.catalogs.map(async (catalog) =>
      Promise.all(
        catalog.items.map(async (item) => {
          return {
            params: { catalogItemSlug: item.link },
            props: { item },
          };
        }),
      ),
    ),
  );

  return pages.flat();
}

const { item } = Astro.props as { item: CatalogItem };

const pdfURL = new URL(item.fileUrl, Astro.url);
---

<StarlightPage frontmatter={{ title: item.label, tableOfContents: false }}>
  <!-- <ScoreTag content={readMe} format='pdf' class='w-full h-full' /> -->
  <ScoreTag url={pdfURL} format='pdf' class='w-full h-full' />
  <!-- <PDFViewer pdfUrl={resolvedPdfUrl} /> -->
</StarlightPage>
