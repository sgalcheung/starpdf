---
import path from 'node:path';
import {
	type DocumentResource,
	fromAstroMarkdown,
	fromBinaryPathOrUrl,
	fromLocalFile,
	fromMarkdownPathOrUrl,
	fromTextContent,
	fromTextPathOrUrl,
	getDocumentViewer,
} from '../server/DocumentViewer.js';
import PDFViewer from './PDFViewer.astro';
import SVGViewer from './SVGViewer.astro';

export interface DocumentViewerProps {
	content?: unknown;
	url?: string;
	format?: 'pdf' | 'svg';
	// Allows passing other attributes to PDFViewer/SVGViewer (such as class, style, alt etc.)
	[key: string]: unknown;
}

const { format = 'pdf', content, url, ...restProps } = Astro.props;

let resource: DocumentResource;

if (content) {
  if ('resourceType' in content && 'filePath' in content) {
    resource = fromLocalFile(content);
  } else {
    throw new Error('<DocumentViewer> Unrecognized content format.');
  }
} else if (url) {
	const ext = path.extname(url).toLowerCase();
  
  if (ext === '.pdf') {
    resource = await fromBinaryPathOrUrl(url);
  } else if (ext === '.txt') {
    resource = await fromTextPathOrUrl(url);
  } else if (ext === '.md' || ext === '.markdown') {
    resource = await fromMarkdownPathOrUrl(url);
  } else {
    throw new Error(`<DocumentViewer> Unsupported file extension for url: ${ext}`);
  }
} else {
	throw new Error('<DocumentViewer> requires either `content` or `url` prop.');
}

const page = await getDocumentViewer(resource, format);
---

{format === 'pdf' ? <PDFViewer page={page} /> : <SVGViewer page={page} />}
